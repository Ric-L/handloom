# Root-level env example — copy relevant sections to backend/.env and frontend/.env

# === Backend (d:\handloom\backend\.env) ===
DATABASE_URL=postgres://postgres:postgres@localhost:5432/handloom_portal?sslmode=disable
JWT_SECRET=change-me-to-at-least-32-random-chars-in-production
PORT=8080
UPLOAD_DIR=./uploads
ALLOWED_ORIGINS=http://localhost:5173
ENFORCE_HTTPS=false

# === Frontend (d:\handloom\frontend\.env) ===
VITE_API_BASE_URL=http://localhost:8080/api/v1
